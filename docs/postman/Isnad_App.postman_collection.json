{
	"info": {
		"_postman_id": "b0a6bcb5-2bc1-5cfb-afc5-ab7bebbe3fd4",
		"name": "Isnad — Website & Model Tests",
		"description": "Tests for the Isnad main website: verification, chat with the model (answered only from the database sources), and the OpenRouter model itself. Select the 'Isnad App' environment and fill app_url, then run folder A in order.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "A — الاختبار الأساسي (بالترتيب)",
			"item": [
				{
					"name": "1 — فحص الموقع",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{app_url}}/health",
							"host": [
								"{{app_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": ""
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"الموقع يعمل (200)\", () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "2 — التحقق من نص",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{app_url}}/api/search",
							"host": [
								"{{app_url}}"
							],
							"path": [
								"api",
								"search"
							]
						},
						"description": "",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"{{query}}\",\n  \"top_k\": 5\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"التحقق نجح (200)\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"console.log(`===== ${body.query} =====\\nالنتيجة: ${body.verdict} — ${body.verdict_message}`);",
									"(body.results || []).forEach((r, i) => console.log(",
									"  `${i + 1}) ${Math.round(r.similarity * 100)}% | ${r.verdict} | ${r.source || \"\"}${r.hukm ? \" | الحكم: \" + r.hukm : \"\"}\\n   ${r.text}`));",
									"pm.test(\"فيه نتيجة معروفة\", () =>",
									"  pm.expect([\"verified\", \"found\", \"distorted\", \"no_match\"]).to.include(body.verdict));"
								]
							}
						}
					]
				},
				{
					"name": "3 — سؤال الموديل عن النص",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{app_url}}/api/chat",
							"host": [
								"{{app_url}}"
							],
							"path": [
								"api",
								"chat"
							]
						},
						"description": "",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"question\": \"{{question}}\",\n  \"context_query\": \"{{query}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"الموديل أجاب (200)\", () => pm.response.to.have.status(200));",
									"pm.test(\"خلال 15 ثانية\", () => pm.expect(pm.response.responseTime).to.be.below(15000));",
									"const body = pm.response.json();",
									"pm.test(\"فيه إجابة\", () => pm.expect(body.answer).to.not.be.empty);",
									"console.log(`===== السؤال: ${pm.environment.get(\"question\")} =====\\n${body.answer}\\nالمصادر: ${(body.sources || []).join(\" · \")}`);"
								]
							}
						}
					]
				},
				{
					"name": "4 — سؤال خارج المصادر (اختبار الأمانة)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{app_url}}/api/chat",
							"host": [
								"{{app_url}}"
							],
							"path": [
								"api",
								"chat"
							]
						},
						"description": "",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"question\": \"{{outside_question}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"الموديل أجاب (200)\", () => pm.response.to.have.status(200));",
									"const answer = pm.response.json().answer || \"\";",
									"console.log(`===== سؤال خارج المصادر: ${pm.environment.get(\"outside_question\")} =====\\n${answer}`);",
									"// The model must say the answer isn't in the sources instead of inventing a ruling.",
									"pm.test(\"اعترف أن الجواب غير موجود في المصادر\", () =>",
									"  pm.expect(answer).to.match(/لا (يوجد|يتضمن|تتضمن|يتوفر|تتوفر|أستطيع|يمكنني)|غير (موجود|متوفر|وارد)|ليس (في|ضمن) السياق|لم (يرد|يذكر|تذكر)/));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "B — اختبارات الأخطاء (يجب أن تُرفض)",
			"item": [
