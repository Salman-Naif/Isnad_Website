# Isnad main website — copy this file to .env and fill in the values.
# Never commit .env to the repository — it is listed in .gitignore.
# On Railway: add these values from the Variables tab, not as a file.

# ===== Database service (Isnad_v1) — required =====
# Its URL on Railway, without a trailing slash
DATABASE_URL=
# The same value as SITE_API_KEY on the database service
SITE_API_KEY=

# ===== Chat model — required =====
# Get a key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ===== Optional (defaults live in app/config.py) =====
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_TOKENS=700
# LLM_REASONING=false          # on makes answers ~4–10 s slower
# CHAT_CONTEXT_PASSAGES=6
# Passages less similar to the question are not given to the chat model
# CHAT_MIN_SIMILARITY=0.56

# Verification thresholds — calibrate with your real sources (docs/postman)
# THRESHOLD_HIGH=0.90          # same text
# THRESHOLD_STRONG=0.75        # reworded text, whatever the words
# THRESHOLD_MID=0.60           # reworded text, if it keeps most of the words:
# MIN_WORD_OVERLAP=0.6         #   share of the query's words found in the text

# Public rate limits per visitor IP, and for all visitors together (a ceiling on cost)
# SEARCH_PER_MINUTE=30
# CHAT_PER_MINUTE=10
# SEARCH_PER_MINUTE_SITE=300
# CHAT_PER_MINUTE_SITE=60

# DATABASE_TIMEOUT_SECONDS=15
# SITE_CONFIG_CACHE_SECONDS=30
# LOG_LEVEL=INFO
